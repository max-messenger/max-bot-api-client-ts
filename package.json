    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.0.0",
    "globals": "^15.15.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "form-data": "^4.0.6",
    "vcf": "^2.1.2"
  },
  "overrides": {
    "flatted": "^3.4.4",
